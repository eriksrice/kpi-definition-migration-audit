#!/bin/sh
set -eu

if command -v uv >/dev/null 2>&1; then
  trial_uv="$(command -v uv)"
elif [ -x "${HOME}/.local/bin/uv" ]; then
  trial_uv="${HOME}/.local/bin/uv"
else
  echo "ERROR: uv was not found. Install uv or place it at ${HOME}/.local/bin/uv." >&2
  exit 1
fi

if [ -n "${TRIAL_WHEELHOUSE:-}" ]; then
  "${trial_uv}" sync --frozen --extra dev --python 3.12 --offline \
    --find-links "${TRIAL_WHEELHOUSE}"
elif [ "${TRIAL_OFFLINE:-0}" = "1" ]; then
  "${trial_uv}" sync --frozen --extra dev --python 3.12 --offline
else
  echo "Installing the complete uv.lock environment. This bootstrap may access the registry once."
  "${trial_uv}" sync --frozen --extra dev --python 3.12
fi

"${trial_uv}" lock --check
echo "PASS: lock-synchronized Python environment is ready at .venv"
